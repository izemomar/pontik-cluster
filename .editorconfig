# EditorConfig - https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.md]
indent_size = 2
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
max_line_length = 88

# A digest-pinned FROM is a single token and must not be wrapped.
[Dockerfile]
max_line_length = unset

# The engine's own plugin descriptors indent with tabs and keep the description on one line.
[plugin.xml]
indent_style = tab
max_line_length = unset

# The license text is verbatim, so please don't reformat it.
[LICENSE]
insert_final_newline = unset
trim_trailing_whitespace = false
max_line_length = unset
